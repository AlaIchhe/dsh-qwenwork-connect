{
  "name": "dsh-qwenwork-connect",
  "version": "1.2.0-rc.1",
  "description": "千问办公（QwenWork）的 DSH 原生模型提供方：Device Flow 登录、直连官方网关、原生 LlmAdapter（零本地回环代理），支持国内版 .cn 与国际版 .ai 双站点",
  "license": "MIT",
  "author": "AaIchhe",
  "type": "module",
  "main": "./dist/host/index.js",
  "bin": {
    "dsh-qwenwork-connect": "dist/cli/login.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qwenwork",
    "千问办公",
    "qwen",
    "model-provider",
    "qwenwork-intl",
    "qwenwork-global"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlaIchhe/dsh-qwenwork-connect.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-repo.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm run verify && npm test",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2 || ^5.0.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-config-editor": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2 || ^4.0.0-0",
    "react": "^18.2.0",
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-config-editor": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "dsh-provider-ui": "^0.1.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./dist/host/index.js",
    "./client": "./dist/client/index.js",
    "./core": "./dist/core/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
